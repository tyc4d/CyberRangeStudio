{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cyberrange/contracts/validation-report.schema.json",
  "title": "ValidationReport",
  "description": "Module 8 output. Three distinct levels must never be conflated: env_build, behavior_repro, full_chain.",
  "type": "object",
  "required": ["levels", "checks"],
  "properties": {
    "scenario_id": { "type": "string" },
    "deployment_id": { "type": "string" },
    "run_at": { "type": "string" },
    "levels": {
      "type": "object",
      "description": "The three reproduction levels, judged separately.",
      "required": ["env_build", "behavior_repro", "full_chain"],
      "properties": {
        "env_build": { "$ref": "#/definitions/status", "description": "Did the isolated environment stand up (all target services running)? PASS only if every service_up check PASSes." },
        "behavior_repro": { "$ref": "#/definitions/status", "description": "Did the individual benign demo behaviors occur as expected? Independent of whether the whole chain ran." },
        "full_chain": { "$ref": "#/definitions/status", "description": "Did the full ordered scenario complete end to end? NEVER PASS if any required attack step is NOT_TESTED or FAIL, or if env_build/behavior_repro are not PASS. Downgraded to the weakest required step." }
      }
    },
    "level_criteria": {
      "type": "object",
      "description": "Plain statement of the rule used to judge each level, so a reader can audit the verdict.",
      "properties": {
        "env_build": { "type": "string" },
        "behavior_repro": { "type": "string" },
        "full_chain": { "type": "string" }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "status"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "category": { "type": "string", "enum": ["service_up", "connectivity", "dependency_present", "behavior", "chain", "segmentation", "version"] },
          "status": { "$ref": "#/definitions/status" },
          "expected": { "type": "string" },
          "observed": { "type": "string" },
          "evidence": { "type": "string", "description": "path to log/artifact proving the result" },
          "action_ref": { "type": "string", "description": "which Scenario IR action this check maps to, if any" }
        }
      }
    },
    "fidelity": {
      "type": "object",
      "description": "What was reproduced vs not, and with what substitutes.",
      "properties": {
        "reproduced": { "type": "array", "items": { "type": "string" }, "description": "action ids fully reproduced" },
        "partial": { "type": "array", "items": { "type": "string" } },
        "not_reproduced": { "type": "array", "items": { "type": "string" } },
        "not_tested": { "type": "array", "items": { "type": "string" } },
        "substitutes_used": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "service_ref": { "type": "string" },
              "real": { "type": "string" },
              "substitute": { "type": "string" },
              "difference": { "type": "string" }
            }
          }
        },
        "summary": { "type": "string" }
      }
    }
  },
  "definitions": {
    "status": { "type": "string", "enum": ["PASS", "FAIL", "PARTIAL", "NOT_TESTED"] }
  }
}
